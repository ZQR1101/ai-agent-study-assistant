MY_MIMO_API_KEY=your_api_key_here
MIMO_API_KEY=
OPENAI_API_KEY=
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ALIBABA_API_KEY=
QWEN_API_KEY=

# Token cost estimate, USD per 1M tokens. Override with real provider pricing if needed.
TOKEN_PRICE_INPUT_USD_PER_1M=0.20
TOKEN_PRICE_OUTPUT_USD_PER_1M=0.80

# LLM-as-Judge evaluation. Set ENABLE_LLM_JUDGE=false to skip automatic scoring.
ENABLE_LLM_JUDGE=true
JUDGE_MODEL=mimo-v2.5
ENABLE_JUDGE_PERSISTENCE=true

# Local RAG embedding model. Local-only avoids slow Hugging Face network probes.
EMBEDDING_MODEL_PATH=./models/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_MODEL_LOCAL_ONLY=true
ENABLE_RAG_WARMUP=false
RAG_WARMUP_LOAD_INDEX=true

# Optional CrossEncoder reranker. Leave disabled or model empty to use retrieval order.
ENABLE_RERANKER=false
RERANKER_MODEL=
RERANKER_TOP_N=20

# PostgreSQL session persistence
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/ai_study_assistant
ENABLE_DB_HISTORY=false
DATABASE_CONNECT_TIMEOUT=1
