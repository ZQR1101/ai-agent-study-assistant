DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DASHSCOPE_API_KEY=
ALIBABA_API_KEY=
QWEN_API_KEY=

# Token cost estimate, USD per 1M tokens. Override with real provider pricing if needed.
TOKEN_PRICE_INPUT_USD_PER_1M=0.20
TOKEN_PRICE_OUTPUT_USD_PER_1M=0.80

# LLM-as-Judge evaluation. Set ENABLE_LLM_JUDGE=false to skip automatic scoring.
ENABLE_LLM_JUDGE=true
JUDGE_MODEL=deepseek-v4-pro
ENABLE_JUDGE_PERSISTENCE=true

# Local RAG embedding model. Local-only avoids slow Hugging Face network probes.
EMBEDDING_MODEL_PATH=./models/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_MODEL_LOCAL_ONLY=true
ENABLE_RAG_WARMUP=false
RAG_WARMUP_LOAD_INDEX=true

# Optional CrossEncoder reranker. Leave disabled or model empty to use retrieval order.
ENABLE_RERANKER=false
RERANKER_MODEL=
RERANKER_TOP_N=20

# PostgreSQL session persistence
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/ai_study_assistant
ENABLE_DB_HISTORY=false
DATABASE_CONNECT_TIMEOUT=1

# Run aggregate persistence (defaults to ./data/runs)
RUNS_DIR=./data/runs
# Browser origins allowed to call the API. Wildcards are rejected.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Requester key required as X-Tool-Approval-Key for dangerous tool invocations.
TOOL_APPROVAL_KEY=replace-with-a-long-random-requester-secret
# Independent approver key required as X-Tool-Approver-Key on the approval endpoint.
# It must differ from TOOL_APPROVAL_KEY. Both secrets must be at least 32 characters.
TOOL_APPROVER_KEY=replace-with-a-different-long-random-approver-secret

# Maximum accepted upload size (default: 10 MiB).
MAX_UPLOAD_SIZE_BYTES=10485760
# Total size allowed for all files in docs/ (default: 100 MiB).
MAX_UPLOAD_TOTAL_BYTES=104857600
# Maximum upload requests parsed concurrently by one backend process.
UPLOAD_MAX_CONCURRENCY=2
UPLOAD_RATE_LIMIT=10
UPLOAD_RATE_WINDOW_SECONDS=60
# Untrusted PDF validation limits (subprocess timeout; POSIX memory cap).
MAX_PDF_PAGES=500
PDF_VALIDATION_TIMEOUT_SECONDS=5
PDF_VALIDATION_MAX_MEMORY_BYTES=268435456

# Maximum image response buffered by /image-proxy (default: 20 MiB).
IMAGE_PROXY_MAX_RESPONSE_BYTES=20971520
# Per-process image proxy concurrency and per-client token-bucket limits.
IMAGE_PROXY_MAX_CONCURRENCY=4
IMAGE_PROXY_RATE_LIMIT=30
IMAGE_PROXY_RATE_WINDOW_SECONDS=60
IMAGE_PROXY_TIMEOUT_SECONDS=20
